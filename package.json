{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "admin:bootstrap": "npm run build && node scripts/bootstrap-admin.cjs",
    "admin:migrate": "npm run build && node scripts/migrate-admins.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:order": "npm run build && node --test tests/order*.test.cjs tests/cart.integration.test.cjs",
    "audit:orders": "npm run build && node scripts/order-audit.cjs",
    "test:cart": "npm run build && node --test tests/cart*.test.cjs tests/order.checkout.test.cjs",
    "predev": "npm run build",
    "dev": "concurrently \"tsc -watch\" \"node --watch dist/index.js\"",
    "test:email": "npm run build && node --test tests/email.queue.test.cjs",
    "test:category": "npm run build && node --test tests/category.*.test.cjs",
    "test:upload": "npm run build && node --test tests/upload*.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.5.4",
    "concurrently": "^10.0.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "file-type": "22.3.0",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "2.5.0",
    "nodemailer": "^10.3.1",
    "sharp": "0.35.5",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
